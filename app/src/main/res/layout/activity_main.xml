<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Heading -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DESTINATION GUIDE"
            android:textColor="@color/secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explore the World 🌍"
            android:textColor="@color/heading"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discover beautiful places and plan your next adventure."
            android:textColor="@color/description"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"/>

        <!-- Search Section -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/search_background"
            android:paddingHorizontal="12dp">

            <EditText
                android:id="@+id/etDestination"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Where do you want to go?"
                android:singleLine="true"
                android:textSize="14sp"
                android:background="@android:color/transparent"
                android:inputType="textCapWords"/>

            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="@color/white"
                android:background="@drawable/search_button_background"
                android:contentDescription="Search"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <!-- Loading Progress -->

        <ProgressBar
            android:id="@+id/searchProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone"/>

        <!-- Travel Banner -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="165dp"
            android:layout_marginTop="25dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="22dp"
            android:background="@drawable/banner_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR NEXT ADVENTURE"
                android:textColor="#BCEDE8"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Travel Beyond\nBoundaries ✈"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

        <!-- Popular Destinations -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Popular Destinations"
            android:textColor="@color/heading"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explore some amazing places"
            android:textColor="@color/description"
            android:textSize="13sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="15dp"/>

        <!-- Paris -->

        <LinearLayout
            android:id="@+id/cardParis"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/destination_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Paris"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paris, France"
                    android:textColor="@color/heading"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The City of Lights"
                    android:textColor="@color/description"
                    android:textSize="13sp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="28sp"
                android:textColor="@color/secondary"/>

        </LinearLayout>

        <!-- Taj Mahal -->

        <LinearLayout
            android:id="@+id/cardTaj"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/destination_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Taj Mahal"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Taj Mahal, India"
                    android:textColor="@color/heading"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Symbol of Eternal Love"
                    android:textColor="@color/description"
                    android:textSize="13sp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="28sp"
                android:textColor="@color/secondary"/>

        </LinearLayout>

        <!-- Bali -->

        <LinearLayout
            android:id="@+id/cardBali"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/destination_card"
            android:padding="12dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Bali"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bali, Indonesia"
                    android:textColor="@color/heading"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Island of Paradise"
                    android:textColor="@color/description"
                    android:textSize="13sp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="28sp"
                android:textColor="@color/secondary"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>